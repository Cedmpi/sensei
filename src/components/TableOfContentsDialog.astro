<button
  id="toc-mobile-btn"
  class="lg:hidden fixed bottom-4 right-4 z-40 flex items-center gap-1.5 bg-white dark:bg-dark border border-neutral-200 dark:border-neutral-700 shadow-lg rounded-full px-3.5 py-2.5 text-sm font-medium cursor-pointer hover:bg-neutral-50 dark:hover:brightness-110 transition-colors"
  aria-label="Table of Contents"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="shrink-0"
    ><line x1="8" y1="6" x2="21" y2="6"></line><line
      x1="8"
      y1="12"
      x2="21"
      y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line
      x1="3"
      y1="6"
      x2="3.01"
      y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line
      x1="3"
      y1="18"
      x2="3.01"
      y2="18"></line></svg
  >
  On This Page
</button>

<dialog
  id="toc-dialog"
  closedby="any"
  class="bg-dark text-white border border-neutral-700 rounded-lg max-w-sm w-[calc(100vw-2rem)] p-4 backdrop:bg-black/70 m-4"
>
  <div class="flex flex-col max-h-[90vh]">
    <div class="flex items-center justify-between px-5 pt-5 pb-0 shrink-0">
      <p class="font-medium text-sm">On This Page</p>
      <button
        id="toc-dialog-close"
        class="flex items-center justify-center size-8 rounded-full hover:bg-white/10 transition-colors cursor-pointer -mr-1"
        aria-label="Close"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <nav class="p-5 overflow-y-auto slim-scrollbar">
      <ul id="page-nav-list-mobile" class="space-y-2 text-sm"></ul>
    </nav>
  </div>
</dialog>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const trigger = document.getElementById("toc-mobile-btn");
    const dialog = document.getElementById("toc-dialog");
    const closeBtn = document.getElementById("toc-dialog-close");
    const mobileList = document.getElementById("page-nav-list-mobile");

    document.body.append(trigger, dialog);

    const headings = [...document.querySelectorAll("h3[id]")];
    if (!headings.length) return;

    const items = headings
      .map(
        (h) =>
          `<li><a href="#${h.id}" class="block py-0.5 hover:underline">${h.dataset.short || h.textContent}</a></li>`,
      )
      .join("");

    if (mobileList) mobileList.innerHTML = items;

    trigger?.addEventListener("click", () => {
      document.body.style.overflow = "hidden";
      dialog?.showModal();
    });

    closeBtn?.addEventListener("click", () => dialog?.close());

    dialog?.addEventListener("close", () => {
      document.body.style.overflow = "";
    });

    mobileList?.addEventListener("click", (e) => {
      const link = (e.target as HTMLElement).closest("a");
      if (!link) return;
      e.preventDefault();
      document
        .querySelector(link.getAttribute("href")!)
        ?.scrollIntoView({ behavior: "smooth" });
      history.replaceState(null, "", link.getAttribute("href")!);
      dialog?.close();
    });
  });
</script>
