---
import BaseLayout from "../layouts/BaseLayout.astro";
import DocumentNav from "../components/DocumentNav.astro";
import TableOfContents from "../components/TableOfContents.astro";

const { title, source, toc } = Astro.props;

const allSessions = Object.entries(
  import.meta.glob("../pages/university/*.md", { eager: true }),
)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([path, mod]: any[]) => ({
    slug: path.match(/\/([^/]+)\.md$/)?.[1] ?? "",
    data: { title: mod.frontmatter?.title ?? mod.title ?? "" },
  }));

const currentSlug = Astro.url.pathname.match(/\/([^/]+)\/?$/)?.[1] ?? "";
const currentIndex = allSessions.findIndex((s) => s.slug === currentSlug);
const prevEntry = currentIndex > 0 ? allSessions[currentIndex - 1] : null;
const nextEntry =
  currentIndex < allSessions.length - 1 ? allSessions[currentIndex + 1] : null;
---

<BaseLayout pageTitle="Dr. Bernstein's Diabetes University" toc={toc}>
  <a href="/university" class="font-medium mb-6">
      Dr. Bernstein's Diabetes University
  </a>

  <article class="space-y-4">
    <h1 class="font-semibold text-xl">{title}</h1>
    <slot />
  </article>
  <a href={source} target="_blank" class="text-xs mt-4">Source</a>

  <DocumentNav prev={prevEntry} next={nextEntry} basePath="university" />
  {toc && <TableOfContents slot="sidebar" />}
</BaseLayout>
