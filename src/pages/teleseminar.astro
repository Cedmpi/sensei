---
import BaseLayout from "../layouts/BaseLayout.astro";

const allSessions = Object.entries(
  import.meta.glob("./teleseminar/*.md", { eager: true }),
)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, value]) => value);
---

<BaseLayout>
  <div class="mb-6 space-y-1">
    <h1 class="font-semibold text-xl">Dr. Bernstein's Teleseminar</h1>
    <div class="text-sm opacity-60 space-y-2">
      <p class="text-xs">
        Transcriptions might be adjusted for readability and accuracy.
      </p>

      <p>
        Dr. Bernstein's Teleseminar is a Q&A session for questions that were not answered in his book Diabetes Solution.
      </p>
    </div>
  </div>
  <nav>
    <ol class="divide-y divide-neutral-200/10">
      {
        allSessions.map((post: any) => (
          <li class="py-2 font-medium">
            <a href={post.url}>{post.frontmatter.title}</a>
          </li>
        ))
      }
    </ol>
  </nav>
</BaseLayout>
