---
import BaseLayout from "../layouts/BaseLayout.astro";

const allSessions = Object.entries(
  import.meta.glob("./teleseminar/*.md", { eager: true }),
)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, value]) => value);
---

<BaseLayout>
  <div class="mb-6 space-y-1">
    <h1 class="font-semibold text-xl">Dr. Bernstein's Teleseminar</h1>
    <div class="text-sm opacity-60 space-y-2">
      <p class="text-xs">
        Transcriptions might be adjusted for readability and accuracy, outdated
        resources may be updated.
      </p>

      <p>
        Dr. Bernstein's Teleseminar is a Q&A session. The answers to the
        questions are based on assumptions about the individual who asked the
        question, and the assumptions may be incorrect and it could be the wrong
        answer.
      </p>

      <p>
        Be warned that the answers are guesses, they're not absolute answers,
        don't run out and do what they say, but discuss the suggestions with
        your doctor.
      </p>

       <p>
        These answers are meant for the large group of listeners, who are
        hearing it and they may learn something even though I may not have the
        adequate answer for the person who asked the question.
      </p>

    </div>
  </div>
  <nav>
    <ol class="divide-y divide-neutral-200/10">
      {
        allSessions.map((post: any) => (
          <li class="py-2 font-medium">
            <a href={post.url}>{post.frontmatter.title}</a>
          </li>
        ))
      }
    </ol>
  </nav>
</BaseLayout>
