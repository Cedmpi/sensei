---
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";
---

<div>
  <PagefindConfig highlight-param="highlight" />

  <div class="flex flex-col gap-0.5 min-h-20" data-pf-theme="dark">
    <style>
      [data-pf-theme="dark"] {
        --pf-text: #e0e0e0;
        --pf-text-secondary: #a0a0a0;
        --pf-text-muted: #888;
        --pf-background: oklch(27% 0.035 258);
        --pf-border: oklch(35% 0.03 258);
        --pf-border-focus: #58a6ff;
        --pf-skeleton: oklch(30% 0.03 258);
        --pf-skeleton-shine: oklch(34% 0.03 258);
        --pf-hover: oklch(33% 0.035 258);
        --pf-mark: #fff5cc;
        --pf-scroll-shadow: rgba(0, 0, 0, 0.4);
        --pf-error-bg: oklch(27% 0.04 25);
        --pf-error-border: oklch(37% 0.06 25);
        --pf-error-text: #fca5a5;
        --pf-outline-focus: #58a6ff;
        --pf-modal-backdrop: rgba(0, 0, 0, 0.7);
      }

      .clear-highlight-btn {
        background: var(--pf-background);
        border: 1px solid var(--pf-border);
        color: var(--pf-text-muted);
      }
    </style>
      <pagefind-modal-trigger placeholder="Search"></pagefind-modal-trigger>
      <pagefind-modal></pagefind-modal>

      <button
        id="clear-highlight-btn"
        class="hidden text-xs px-2 py-1 rounded-sm cursor-pointer clear-highlight-btn ml-auto"
        title="Remove search highlights (Escape)"
      >
        Clear Highlights
        <span class="pf-trigger-shortcut" aria-hidden="true"
          ><span class="pf-trigger-key">Esc</span></span
        >
      </button>
  </div>

  <script>
    const clearBtn = document.getElementById("clear-highlight-btn");
    if (clearBtn) {
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.has("highlight")) {
        clearBtn.classList.remove("hidden");
      }

      const clearHighlights = () => {
        const marks = document.querySelectorAll("mark");
        marks.forEach((mark) => {
          const parent = mark.parentNode;
          if (parent) {
            parent.replaceChild(
              document.createTextNode(mark.textContent || ""),
              mark,
            );
            parent.normalize();
          }
        });

        clearBtn.classList.add("hidden");
        const cleanUrl = new URL(window.location.href);
        cleanUrl.searchParams.delete("highlight");
        history.replaceState(null, "", cleanUrl.toString());
      };

      clearBtn.addEventListener("click", clearHighlights);

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          e.preventDefault();
          if (!clearBtn.classList.contains("hidden")) {
            clearHighlights();
          }
        }
      });
    }
  </script>
</div>
